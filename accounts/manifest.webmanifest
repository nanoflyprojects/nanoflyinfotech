{
  "name": "NanoFly InfoTech Accounts",
  "short_name": "NanoFly",
  "description": "Clients, invoices, quotations, receipts and payments for NanoFly InfoTech",
  "id": "./index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#291B25",
  "theme_color": "#291B25",
  "categories": ["business", "finance", "productivity"],
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New invoice", "url": "./index.html#invoices", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Payments", "url": "./index.html#payments", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
